{
  "id": "/collect/",
  "name": "My Collection Tracker",
  "short_name": "Collection",
  "description": "Keep track of which mystery-box figures you have found.",
  "start_url": "/collect/",
  "scope": "/collect/",
  "display": "standalone",
  "orientation": "any",
