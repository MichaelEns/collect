      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/collect/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/collect/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
