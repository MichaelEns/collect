/*
 * The shape of a collectible set.
 *
 * Everything the app knows about a collection lives in one of these files, so
 * adding a new mystery-box line means dropping a JSON file into sets/ and
 * naming it in sets/index.json. No code changes.
 *
 * This file is the contract, kept next to the data it describes. It is loaded
 * by the tests, so a set file that drifts from it fails the build rather than
 * failing quietly on a child's tablet.
 */
{
  "$comment": "Not JSON Schema — deliberately small and readable. See tests/sets.test.mjs.",

  "required": ["id", "brand", "name", "figures"],

  "fields": {
    "id": "Stable slug. Used as the localStorage key, so changing it loses progress.",
    "brand": "Who makes it, e.g. 'Disney Doorables'.",
    "name": "The set name, e.g. 'Galaxy Peek Series 2'.",
    "packaging": "Optional. How to recognise the box on a shelf, e.g. 'Grey AT-AT capsule'. This is the field a child actually uses, so do not guess it.",
    "packagingNote": "Optional caveat about the packaging, shown as a highlighted warning under the progress bar. Use when the colour or shape is unconfirmed.",
    "countNote": "Optional caveat about the number of figures, shown the same way.",
    "rarityNote": "Optional caveat about the rarity tiers, shown the same way.",
    "theme": "Optional one-line description of what the series is about.",
    "itemNumber": "Optional manufacturer SKU.",
    "upc": "Optional barcode.",
    "released": "Optional release date, YYYY, YYYY-MM or YYYY-MM-DD.",
    "figuresPerCapsule": "How many figures come in one capsule. Used to validate the code files.",
    "official": "Optional URL to the manufacturer's own page for this product.",
    "sourced": "Where the roster came from. Shown to the user. Be honest here.",
    "verified": "true only if every figure is confirmed against an official source.",
    "numberLabel": "Optional. What the printed number is called, e.g. 'Bag #'.",
    "numberNote": "Optional. Where that number is printed. Must mention the checklist inside.",
    "codeNote": "Optional. Explains where the capsule code is, that the leading letter is the batch, and that the codes are unofficial. Tested for all three.",
    "codeFile": "Optional. Name of the codes-*.json file holding the capsule lookup for this set.",
    "codeLink": "Optional URL to the community code list.",
    "codeLinkLabel": "Optional label for that link.",
    "rarities": "Optional list of { id, label, colour } in increasing rarity.",
    "figures": "The roster."
  },

  "figure": {
    "id": "Stable slug, unique within the set. The key progress is stored under.",
    "name": "What it is called.",
    "number": "Optional. The number printed beside it on the paper checklist.",
    "numberUnknown": "Optional true, when the printed number could not be established.",
    "rarity": "Optional. Must match a rarities[].id.",
    "verified": "false marks it as unconfirmed, and the app says so on the card.",
    "note": "Optional free text shown on the detail card."
  },

  "$codeFileComment": "A codes-<setId>.json file maps a capsule code to the figures inside it. Generated by tools/build_codes.cjs; do not hand-edit.",

  "codeFile": {
    "setId": "The set these codes belong to. The filename must be codes-<setId>.json.",
    "source": "Required { title, credit, url, retrieved }. Shipping codes without saying where they came from fails the tests.",
    "batches": "Map of batch letter to how many codes are known for it.",
    "codes": "Map of code to an array of figure ids, exactly figuresPerCapsule long, all of which must exist in the set.",
    "disputed": "Map of code to an array of differing figure lists, where contributors did not agree. Every version is kept and shown; picking one silently would state a guess as fact."
  }
}
